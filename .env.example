# OpsFlow AI .env Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://opsflow:opsflow_dev@localhost:5432/opsflow

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI API (支持自定义兼容 API)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Settings
LLM_MODEL=gpt-4o

# File Upload
UPLOAD_DIR=./uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
